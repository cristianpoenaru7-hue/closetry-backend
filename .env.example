# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wardrobe?schema=public"

# JWT signing secret — generate a long random string for real use
# e.g. `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000

# Cloudinary — OPTIONAL image storage/CDN. If left unset, photos are
# saved locally instead (dev only). Background removal does NOT depend on
# this anymore — see BG_REMOVAL_URL below.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Local background-removal microservice (see /bg-removal-service in this
# repo) — runs entirely on your own infrastructure, no external API, no
# account, no per-image cost. Must be running for uploads to get
# background-removed; if it's down, uploads still succeed with the
# original (un-removed) photo and a warning in the logs.
BG_REMOVAL_URL="http://localhost:5001"

# Local upload dir — used only as a fallback when Cloudinary isn't
# configured above (dev only, swap for real storage before launch).
UPLOAD_DIR="uploads"

# Anthropic API — powers the Generate tab (text-only outfit-generation
# calls, see 03-ai-integration.md). Get a key at console.anthropic.com.
# Without this set, /api/generation/sessions/:id/messages returns a 503.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5"

# OpenWeatherMap — powers weather-aware generation (Phase 4). Get a free
# key at openweathermap.org/api. Without this set, /api/weather returns a
# 503; the mobile client treats that as "weather unavailable" and
# generation still works exactly as before.
OPENWEATHER_API_KEY=""

# Resend — powers the Contact us form. Get a key at resend.com (free tier
# is plenty for this). Without it set, POST /api/contact returns 503.
RESEND_API_KEY=""
# Defaults to cristianpoenaru7@gmail.com if unset.
CONTACT_EMAIL_TO=""
# Defaults to Resend's shared sandbox sender (works without verifying
# your own domain, but has lower deliverability) — set to a verified
# "you@yourdomain.com" before real launch.
CONTACT_EMAIL_FROM=""
